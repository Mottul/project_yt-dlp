{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MottulVideoLoader",
  "version": "0.1.0",
  "identifier": "com.mottul.videoloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MottulVideoLoader",
        "width": 880,
        "height": 720,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": true,
        "theme": "Dark",
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© Mottul",
    "category": "Utility",
    "shortDescription": "Video-Downloader auf Basis von yt-dlp",
    "longDescription": "Schlanke Oberfläche für yt-dlp. Lädt yt-dlp und ffmpeg beim ersten Start selbst und hält yt-dlp aktuell.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
